{
  "manifest_version": 3,
  "name": "SharePoint Video Downloader",
  "description": "Save SharePoint videos from your signed-in browser. Verified downloads through a local helper.",
  "version": "0.2.1",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download SharePoint video",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_permissions": [
    "notifications"
  ],
  "icons": {
    "128": "icon128.png"
  }
}
